# Ignore
node_modules/
.temp_ag_kit/
antigravity-doc

# Variáveis de ambiente e segredos (exceções vêm depois de .env.* e *.env)
.env
.env.*
*.env
!.env.example
!*.env.example

# MCP configs com chave de API embutida na URL (nao versionar)
.mcp.json
opencode.json
.cursor/mcp.json
.vscode/mcp.json
.gemini/settings.json
.codex/config.toml
.zed/settings.json
config/mcporter.json

# macOS / Python
.DS_Store
__pycache__/
*.pyc

# Generated/cache output (Output/ holds a nested git repo)
Output/
.firecrawl/

# Planos e histórico de execução de agentes (privacidade local)
.agent/plans/
plans/

# Documentação e controle de skills de terceiros (privacidade/controle local)
.agent/vendor/

# SIPs instalados aqui como consumidor (symlink -> path absoluto de outro hub,
# nao portavel entre maquinas/clones). Fonte de verdade fica no hub, nao aqui.
.claude/skills/sip-*
# SIPs de dominio consumidos pelo dono (ponteiros para hubs na maquina dele) e o manifesto deles:
# cada usuario instala os seus pelo prompt de instalacao de cada SIP.
# O resolver do proprio kit (sip-geral) nao mora aqui: fica versionado em prompts/resolver/sip-geral/.
.agent/skills/sip-*/
.agent/SIPS-CONSUMIDOS.md
# Local onde o kit foi instalado (escrito por localize_paths.py)
.agent/.kit-path

# Agents/workflows de SIPs instalados (sem prefixo fixo, listar cada um ao
# instalar via o prompt de instalacao - ver projetos/_sips.md):
.claude/agents/n8n-agent.md
.claude/commands/buscar-jornalistas-e-veiculos.md
.claude/commands/criar-personalizar-releases.md
.claude/commands/onboarding-novo-jornalista.md
.claude/commands/perfil-jornalista.md
.claude/commands/radar-semanal.md

# Fichas de projetos reais e históricos privados
projetos/

# Conteúdo local do hub: contribuições pendentes e registro de consumidores
# (caminhos absolutos de outros projetos; não é conhecimento de domínio)
inbox/*
!inbox/README.md
instalacoes/*
!instalacoes/README.md

# Regras locais personalizadas da máquina (usar CLAUDE.example.md como base)
CLAUDE.md
AGENTS.md
GEMINI.md
.agent/rules/
# (GEMINI.md e .agent/rules/ são legado: o kit não os gera mais; seguem ignorados para não subirem por engano)
.claude/CLAUDE.md
.cursorrules


# SIP - Astro (generated, holds a path of this machine)
.agent/skills/sip-astro
.claude/skills/sip-astro
.agent/.sip-hubs.local.json
